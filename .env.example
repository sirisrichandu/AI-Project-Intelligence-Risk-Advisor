# GEMINI_API_KEY: Required for optional Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FastAPI Backend Configuration
# Port 8001 is used because port 8000 is reserved by internal control-plane in this environment.
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT="8001"
FASTAPI_URL="http://127.0.0.1:8001"

# Frontend API Base URL (React + Vite)
# If left empty, Vite proxies all /api requests directly to FASTAPI_URL (http://127.0.0.1:8001)
VITE_API_BASE_URL="http://localhost:8001"

# ChromaDB Native Persistent Storage Directory
CHROMA_PERSIST_DIR="./backend/storage/chroma_db"

